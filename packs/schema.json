{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.local/schemas/instrument-pack.schema.json",
  "title": "Cadence Instrument Pack",
  "description": "Data-driven synthesis preset pack for Cadence (schema_version 1). Pure JSON, no code, no samples. Rust validation in src/packs.rs is authoritative and rejects unknown fields; this schema mirrors it for editors and cheap AI generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "instruments"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Pack format version. Only 1 is supported."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!.*\\.\\.)[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "description": "Pack id slug: lowercase a-z, 0-9, '-', '_' and '.', no leading/trailing '.' or '..'. Becomes the installed file name <id>.json."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 1000, "default": "" },
    "author": { "type": "string", "maxLength": 1000, "default": "" },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/preset" }
    }
  },
  "$defs": {
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "oscillators"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^(?=.*\\.)[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
          "description": "Namespaced instrument id slug, e.g. eight-bit.pulse-lead. Unique across all loaded packs; first definition wins."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000, "default": "" },
        "oscillators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/oscillator" }
        },
        "envelope": {
          "$ref": "#/$defs/envelope",
          "description": "ADSR-style amplitude envelope in seconds."
        },
        "filter_cutoff": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000,
          "default": 20000,
          "description": "Low-pass filter cutoff in Hz."
        },
        "bit_depth": {
          "type": "integer",
          "minimum": 4,
          "maximum": 24,
          "default": 24,
          "description": "Bitcrush depth. 24 = full quality; 4-8 gives lo-fi grit."
        },
        "sample_hold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 1,
          "description": "Sample-and-hold interval in samples. 1 = off; higher values add aliasing grit."
        },
        "gain": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
        "monophonic": { "type": "boolean", "default": false }
      }
    },
    "oscillator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waveform": {
          "type": "string",
          "enum": ["sine", "triangle", "saw", "square", "pulse", "noise"],
          "default": "sine"
        },
        "level": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "frequency_ratio": {
          "type": "number",
          "minimum": 0.125,
          "maximum": 16,
          "default": 1.0,
          "description": "Frequency multiplier vs the played note. 0.5 = octave down, 2.0 = octave up, 4.0 = two octaves."
        },
        "detune_cents": { "type": "number", "minimum": -100, "maximum": 100, "default": 0.0 },
        "pulse_width": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95,
          "default": 0.5,
          "description": "Fraction of the cycle the pulse stays high (0.5 = 50% duty). Only used by the pulse waveform."
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attack": { "type": "number", "minimum": 0, "maximum": 5, "default": 0.01 },
        "decay": { "type": "number", "minimum": 0, "maximum": 10, "default": 0.2 },
        "sustain": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "release": { "type": "number", "minimum": 0.005, "maximum": 20, "default": 0.3 }
      },
      "description": "Times in seconds; sustain is a 0..1 level."
    }
  }
}
