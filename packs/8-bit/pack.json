        { "waveform": "pulse", "level": 0.85, "frequency_ratio": 1.0, "detune_cents": 0.0, "pulse_width": 0.25 },
        { "waveform": "pulse", "level": 0.4, "frequency_ratio": 0.5, "detune_cents": 0.0, "pulse_width": 0.5 }
      ],
      "envelope": { "attack": 0.003, "decay": 0.18, "sustain": 0.3, "release": 0.12 },
      "filter_cutoff": 6500.0,
      "bit_depth": 8,
      "sample_hold": 2,
      "gain": 0.85,
      "monophonic": true
    },
    {
      "id": "eight-bit.square-lead",
